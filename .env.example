# GitHub
GITHUB_TOKEN=
GITHUB_REPO=openai/codex

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI provider (mimo today; openai can be added later in pipeline/ai/)
AI_PROVIDER=mimo
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_CLASSIFICATION_MODEL=mimo-v2.5-pro
MIMO_EMBEDDING_MODEL=

# Embeddings (independent of the classification provider; local runs in-process)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
LOCAL_EMBEDDING_PREFIX=passage:

# OpenAI (kept for the future openai provider — do NOT put the MiMo key here)
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pipeline
SIGNAL_ANALYSIS_VERSION=v0.3.0
SIGNAL_MIN_CONFIDENCE=0.60
SIGNAL_MIN_CLUSTER_SIZE=5
SIGNAL_EMERGING_MIN_VOLUME=5
SIGNAL_EMERGING_MIN_GROWTH=0.50

# App
NEXT_PUBLIC_APP_NAME=Signal
NEXT_PUBLIC_CASE_STUDY=OpenAI Codex
